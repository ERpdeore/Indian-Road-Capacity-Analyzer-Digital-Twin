diff --git a/road_analyzer_deploy/matlab_twin/build_traffic.m b/road_analyzer_deploy/matlab_twin/build_traffic.m
new file mode 100644
index 0000000..2ce7916
--- /dev/null
+++ b/road_analyzer_deploy/matlab_twin/build_traffic.m
@@ -0,0 +1,168 @@
+function planned = build_traffic(rrApp, mode, speedKmh, roadLength_m, opts)
+%BUILD_TRAFFIC  Dense, mixed, MOVING traffic for the ideal or defect road.
+%
+%   Replaces the old "6 sedans that barely move". Vehicles are
+%     * a mix of cars, two-wheelers, trucks, buses and vans (twin_config.m)
+%     * packed lane by lane with a real gap, so they never overlap
+%     * given a speed and a route, so they actually drive when you press Play
+%     * fewer on the defect road, in proportion to the REAL capacity loss
+%
+%   mode          : 'ideal' or 'nonideal'
+%   speedKmh      : real free-flow (ideal) or congested (nonideal) speed
+%   roadLength_m  : real road length
+%   opts (optional struct, every field optional):
+%     .projectFolder  RoadRunner project folder (lets twin_assets list your real assets)
+%     .numLanes       lanes on the road (default 2)
+%     .totalWidth_m   road width in metres (default 7)
+%     .keepFraction   nonideal only: reduced/original capacity, 0..1 (default 1)
+%     .targetCount    force an exact vehicle count instead
+%     .scenarioFile   file name to save the scenario to
+%
+%   Returns the number of vehicles planned.
+
+    cfg = twin_config();  tc = cfg.traffic;
+    if nargin < 5 || isempty(opts), opts = struct(); end
+    mode = lower(char(mode));
+    if nargin < 3 || isempty(speedKmh),     speedKmh = tc.defaultSpeedKmh.(mode); end
+    if nargin < 4 || isempty(roadLength_m), roadLength_m = 40; end
+
+    nLanes       = max(1, round(getOpt(opts, 'numLanes', 2)));
+    totalWidth   = getOpt(opts, 'totalWidth_m', 7.0);
+    laneW        = totalWidth / nLanes;
+    keepFraction = getOpt(opts, 'keepFraction', 1);
+    target       = getOpt(opts, 'targetCount', []);
+    scenarioFile = char(getOpt(opts, 'scenarioFile', [mode '_traffic.rrscenario']));
+
+    %% ---- lane table: lateral centre t, travel direction, rank (1 = inner)
+    nLeft  = ceil(nLanes/2);               % same split as roadrunner_export.py
+    nRight = nLanes - nLeft;
+    plusDir = 1;  if ~tc.rightLanesTravelPlusX, plusDir = -1; end
+    lanes = struct('t',{},'dir',{},'rank',{});
+    for i = 1:nRight, lanes(end+1) = struct('t', -(i-0.5)*laneW, 'dir',  plusDir, 'rank', i); end %#ok<AGROW>
+    for i = 1:nLeft,  lanes(end+1) = struct('t',  (i-0.5)*laneW, 'dir', -plusDir, 'rank', i); end %#ok<AGROW>
+
+    %% ---- plan the vehicle slots lane by lane (no overlaps, fixed seed)
+    rng(tc.seed);
+    cats   = fieldnames(tc.mix);
+    wts    = cellfun(@(c) tc.mix.(c), cats);
+    cumw   = cumsum(wts) / sum(wts);
+    usable = max(roadLength_m - 2*tc.margin_m, 1);
+    packLen = (1 - tc.travelReserve) * usable;     % traffic starts in this part,
+    reserve = tc.travelReserve * usable;           % and drives into the rest
+    slots = zeros(0,3);                            % [lane index, x centre, category index]
+    for li = 1:numel(lanes)
+        dirn = lanes(li).dir;
+        if dirn > 0
+            x = tc.margin_m;                 limit = x + packLen;
+        else
+            x = roadLength_m - tc.margin_m;  limit = x - packLen;
+        end
+        while true
+            ci  = find(rand <= cumw, 1);
+            len = tc.length_m.(cats{ci});
+            xc  = x + dirn*len/2;
+            far = xc + dirn*len/2;
+            if (dirn > 0 && far > limit) || (dirn < 0 && far < limit), break; end
+            slots(end+1,:) = [li, xc, ci]; %#ok<AGROW>
+            x = far + dirn*tc.gap_m;
+        end
+    end
+    if isempty(slots)
+        slots = [1, roadLength_m/2, 1];
+        warning('build_traffic:RoadTooShort', 'Road is very short -- placing a single vehicle.');
+    end
+
+    %% ---- how many to show
+    n      = size(slots,1);
+    nIdeal = min(n, tc.maxVehicles);
+    if ~isempty(target)
+        nKeep = min(target, n);
+    elseif strcmp(mode, 'nonideal')
+        nKeep = max(min(tc.minVehicles, nIdeal), round(nIdeal * min(max(keepFraction,0),1)));
+    else
+        nKeep = nIdeal;
+    end
+    nKeep = max(1, min(nKeep, tc.maxVehicles));
+    if nKeep < n
+        slots = slots(unique(round(linspace(1, n, nKeep))), :);   % thin evenly: gaps only grow
+    end
+    planned = size(slots,1);
+    fprintf('      Traffic plan (%s): %d vehicles on %d lane(s), %.0f km/h, %.0f m road.\n', ...
+        mode, planned, numel(lanes), speedKmh, roadLength_m);
+
+    %% ---- place them
+    newScenario(rrApp);
+    rrApi = roadrunnerAPI(rrApp);
+    scnro = rrApi.Scenario;
+    prj   = rrApi.Project;
+    A = twin_assets(prj, getOpt(opts, 'projectFolder', ''));
+
+    used  = struct();  for c = 1:numel(cats), used.(cats{c}) = 0; end
+    placed = 0;  speedFailed = 0;
+    for k = 1:planned
+        try
+            lane   = lanes(slots(k,1));
+            cat    = cats{slots(k,3)};
+            startX = slots(k,2);
+            used.(cat) = used.(cat) + 1;
+            asset  = pickAsset(A, cat, used.(cat));
+
+            side = mod(k,2)*2 - 1;                       % alternates -1 / +1
+            lat  = lane.t;
+            if strcmp(cat, 'twoWheeler')
+                lat = lat + side * min(max(laneW/2 - 0.6, 0), 1.2);   % hug the lane edge
+            elseif strcmp(mode, 'nonideal')
+                lat = lat + side * tc.weave_m;                        % weave round obstructions
+            end
+
+            kmh = speedKmh * (1 - tc.laneSpeedStep * (lane.rank - 1));
+            mps = kmh / 3.6;
+            % Everyone in a lane drives the SAME distance, so gaps never close.
+            dist = min(mps * tc.simSeconds, reserve);
+            endX = startX + lane.dir * max(dist, 1);
+
+            car = addActor(scnro, asset, [startX, lat, 0]);
+            autoAnchor(car.InitialPoint, PosePreservation="reset-pose");
+            if ~setPointSpeed(car.InitialPoint, mps), speedFailed = speedFailed + 1; end
+
+            rrRoute  = car.InitialPoint.Route;
+            endPoint = addPoint(rrRoute, [endX, lat, 0]);
+            autoAnchor(endPoint, PosePreservation="reset-pose");
+            setPointSpeed(endPoint, mps);
+
+            placed = placed + 1;
+        catch e
+            warning('build_traffic:PlacementFailed', 'Could not place vehicle %d: %s', k, e.message);
+        end
+    end
+
+    if speedFailed > 0
+        warning('build_traffic:SpeedNotSet', ...
+            ['Could not set vehicle speeds through the API on this RoadRunner release.\n' ...
+             'In RoadRunner Scenario, select the vehicles and set their Initial Speed there.']);
+    end
+    saveScenario(rrApp, scenarioFile);
+    fprintf('      %d of %d vehicles placed, anchored and saved to %s.\n', placed, planned, scenarioFile);
+end
+
+%% ---------------------------------------------------------------- helpers
+function v = getOpt(opts, name, default)
+    if isfield(opts, name) && ~isempty(opts.(name)), v = opts.(name); else, v = default; end
+end
+
+function a = pickAsset(A, cat, n)
+    pool = A.vehicles.(cat);
+    if isempty(pool), pool = A.vehicles.car; end
+    if isempty(pool), pool = struct2cell(A.vehicles); pool = [pool{:}]; end
+    a = pool{mod(n-1, numel(pool)) + 1};
+end
+
+function ok = setPointSpeed(pt, mps)
+% Speed (m/s) on a route point -- the Point object has a Speed property.
+    ok = true;
+    try
+        pt.Speed = mps;
+    catch
+        ok = false;
+    end
+end
diff --git a/road_analyzer_deploy/matlab_twin/twin_assets.m b/road_analyzer_deploy/matlab_twin/twin_assets.m
new file mode 100644
index 0000000..64b96e8
--- /dev/null
+++ b/road_analyzer_deploy/matlab_twin/twin_assets.m
@@ -0,0 +1,108 @@
+function A = twin_assets(prj, projectFolder)
+%TWIN_ASSETS  Finds the vehicle and prop assets that REALLY exist in your
+%   RoadRunner project, instead of hard-coding one file name.
+%
+%   A.vehicles.car / twoWheeler / truck / bus / van : cell arrays of assets
+%   A.props.cone / barrier / barrel                 : one prop asset each
+%
+%   prj           : rrApi.Project
+%   projectFolder : path of the RoadRunner project (used to list files on
+%                   disk). If empty, only the known default names are tried.
+%
+%   Anything that cannot be found falls back to a car / a traffic cone, so
+%   the scene always builds; a summary of what was found is printed.
+
+    if nargin < 2, projectFolder = ''; end
+    cats = {'car','twoWheeler','truck','bus','van'};
+    A.vehicles = struct();
+    for k = 1:numel(cats), A.vehicles.(cats{k}) = {}; end
+
+    % file-name keywords -> category (first match wins)
+    rules = { 'twoWheeler', ["motorcycle","motorbike","scooter","moped","bicycle","bike"]; ...
+              'bus',        "bus"; ...
+              'truck',      ["truck","lorry","trailer","semi"]; ...
+              'van',        "van"; ...
+              'car',        ["sedan","hatch","suv","coupe","wagon","taxi","pickup","car"] };
+
+    %% ---- vehicles
+    vehPaths = discoverAssets(projectFolder, 'Vehicles');
+    if isempty(vehPaths), vehPaths = "Vehicles/Sedan.fbx"; end
+    for k = 1:numel(vehPaths)
+        asset = tryAsset(prj, vehPaths(k), "VehicleAsset");
+        if isempty(asset), continue; end
+        name = lower(lastPart(vehPaths(k)));
+        cat = 'car';                                  % unknown vehicles count as cars
+        for r = 1:size(rules,1)
+            if any(contains(name, rules{r,2})), cat = rules{r,1}; break; end
+        end
+        A.vehicles.(cat){end+1} = asset;
+    end
+    if all(cellfun(@(c) isempty(A.vehicles.(c)), cats))
+        error('twin_assets:NoVehicles', ...
+            ['No vehicle asset could be loaded from the project.\n' ...
+             'Check that Assets/Vehicles contains at least one vehicle (e.g. Sedan.fbx_rrx).']);
+    end
+    fprintf('      Vehicle assets found:');
+    for k = 1:numel(cats), fprintf('  %s=%d', cats{k}, numel(A.vehicles.(cats{k}))); end
+    fprintf('\n');
+
+    %% ---- props (defect markers)
+    propPaths = discoverAssets(projectFolder, 'Props');
+    knownCone = "Props/TrafficControl/TrafficCone01.fbx";
+    A.props.cone = firstProp(prj, propPaths, ["cone"], ["guardrail","wall"], knownCone);
+    if isempty(A.props.cone)
+        error('twin_assets:NoCone', 'Could not load %s from the project.', knownCone);
+    end
+    A.props.barrier = firstProp(prj, propPaths, ["barricade","barrier","blockade"], ...
+                                ["guardrail","wall","rail"], "");
+    A.props.barrel  = firstProp(prj, propPaths, ["barrel","drum","bin","trash","garbage"], ...
+                                strings(1,0), "");
+    if isempty(A.props.barrier), A.props.barrier = A.props.cone; end
+    if isempty(A.props.barrel),  A.props.barrel  = A.props.cone; end
+end
+
+%% ---------------------------------------------------------------- helpers
+function paths = discoverAssets(projectFolder, sub)
+% List <project>/Assets/<sub>/**/*_rrx and return paths as getAsset expects
+% them: relative to Assets, forward slashes, without the trailing "_rrx".
+    paths = strings(0,1);
+    if isempty(projectFolder), return; end
+    root = fullfile(projectFolder, 'Assets');
+    if ~isfolder(fullfile(root, sub)), return; end
+    d = dir(fullfile(root, sub, '**', '*_rrx'));
+    d = d(~[d.isdir]);
+    for k = 1:numel(d)
+        full = string(fullfile(d(k).folder, d(k).name));
+        rel  = extractAfter(full, string(root) + filesep);
+        rel  = replace(rel, filesep, "/");
+        paths(end+1,1) = regexprep(rel, '_rrx$', ''); %#ok<AGROW>
+    end
+end
+
+function asset = tryAsset(prj, path, type)
+    try
+        asset = getAsset(prj, path, type);
+    catch
+        asset = [];
+    end
+end
+
+function s = lastPart(path)
+    parts = split(string(path), "/");
+    s = parts(end);
+end
+
+function asset = firstProp(prj, propPaths, include, exclude, fallback)
+% First loadable prop whose FILE NAME contains an include word and no exclude word.
+    asset = [];
+    for k = 1:numel(propPaths)
+        name = lower(lastPart(propPaths(k)));
+        if any(contains(name, include)) && ~any(contains(name, exclude))
+            asset = tryAsset(prj, propPaths(k), "MovableObjectAsset");
+            if ~isempty(asset), return; end
+        end
+    end
+    if strlength(fallback) > 0
+        asset = tryAsset(prj, fallback, "MovableObjectAsset");
+    end
+end
diff --git a/road_analyzer_deploy/matlab_twin/twin_config.m b/road_analyzer_deploy/matlab_twin/twin_config.m
new file mode 100644
index 0000000..ae29570
--- /dev/null
+++ b/road_analyzer_deploy/matlab_twin/twin_config.m
@@ -0,0 +1,43 @@
+function cfg = twin_config()
+%TWIN_CONFIG  Every look-and-feel setting of the RoadRunner twin in ONE place.
+%   Edit the numbers below -- no other file needs to change.
+%
+%   Used by: build_traffic.m, add_defects_to_scene.m, twin_assets.m
+
+%% ===================== TRAFFIC =====================
+cfg.traffic.gap_m          = 3.0;    % bumper-to-bumper gap on the ideal road
+cfg.traffic.margin_m       = 3.0;    % keep clear of the road start / end
+cfg.traffic.minVehicles    = 8;      % never show fewer than this (defect road)
+cfg.traffic.maxVehicles    = 80;     % cap for very long corridors
+cfg.traffic.simSeconds     = 40;     % how long vehicles drive (distance = speed * this)
+cfg.traffic.travelReserve  = 0.40;   % share of the road kept free ahead of the traffic
+cfg.traffic.laneSpeedStep  = 0.06;   % each lane away from the centreline is 6% slower
+cfg.traffic.weave_m        = 0.25;   % sideways weave on the defect road
+cfg.traffic.seed           = 7;      % fixed seed -> identical traffic every run
+cfg.traffic.rightLanesTravelPlusX = true;   % OpenDRIVE default: lanes with t<0 drive +x
+% Vehicle mix (fractions, normalised automatically)
+cfg.traffic.mix      = struct('car',0.45,'twoWheeler',0.25,'truck',0.15,'bus',0.10,'van',0.05);
+% Typical lengths (m), used to space vehicles so they never overlap
+cfg.traffic.length_m = struct('car',4.5,'twoWheeler',2.0,'truck',8.5,'bus',11.0,'van',5.0);
+% Used only when the capacity JSON has no speed
+cfg.traffic.defaultSpeedKmh = struct('ideal',50,'nonideal',30);
+
+%% ===================== DEFECT VISIBILITY =====================
+% A real pothole (~0.4 m) or barricade is far too small to see on a road
+% model in RoadRunner. Each defect is therefore drawn as a CLUSTER of markers
+% over an ENLARGED footprint:
+%   footprint = max(measured size * scale, minimum size)
+%   kind      : 'ring' (markers around the edge), 'row' (a line across the
+%               road), 'fill' (a grid), 'single', 'vehicle' (a parked vehicle)
+%   prop      : 'cone', 'barrier' or 'barrel' (falls back to cone if the
+%               project has no such prop)
+mk = @(kind,L,W,sc,sp,prop,maxN,veh) struct('kind',kind,'minLength_m',L,'minWidth_m',W, ...
+        'scale',sc,'spacing_m',sp,'prop',prop,'maxMarkers',maxN,'vehicle',veh);
+cfg.defect.default         = mk('fill',   1.0, 1.0, 1.5, 0.40, 'cone',    16, '');
+cfg.defect.pothole         = mk('ring',   1.4, 1.4, 1.5, 0.35, 'cone',    24, '');
+cfg.defect.barricade       = mk('row',    0.5, 3.0, 1.5, 0.80, 'barrier', 12, '');
+cfg.defect.illegal_parking = mk('vehicle',0,   0,   1.0, 0,    'cone',     1, 'car');
+cfg.defect.street_vendor   = mk('ring',   1.8, 1.8, 1.2, 0.50, 'cone',    16, '');
+cfg.defect.garbage         = mk('fill',   1.2, 1.2, 1.5, 0.40, 'barrel',  16, '');
+cfg.defect.tree            = mk('single', 0.5, 0.5, 1.0, 0.50, 'cone',     1, '');
+end
